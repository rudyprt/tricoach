generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  avatarUrl    String?
  plan         String   @default("free")
  /// Fuseau IANA de l'athlète : la semaine d'entraînement est calculée dessus.
  timezone     String   @default("Europe/Paris")
  createdAt    DateTime @default(now())

  profile       AthleteProfile?
  trainingPlans TrainingPlan[]
  sessions      Session[]
  chatMessages  ChatMessage[]
  resetTokens   PasswordResetToken[]
}

model AthleteProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  objectif      String
  objectifDate  DateTime
  tempsNatation String   @default("")
  tempsVelo     String   @default("")
  tempsCourse   String   @default("")
  heuresSemaine Float
  contraintes   String   @default("")
  /// Zones de puissance vélo si l'athlète connaît sa FTP (sinon estimation par la vitesse).
  ftpWatts      Int?
  updatedAt     DateTime @updatedAt
}

model TrainingPlan {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekStart   DateTime
  generatedAt DateTime  @default(now())
  rawAiJson   String
  debrief     String?
  /// Phase de périodisation appliquée (base, developpement, specifique, affutage, course, transition).
  phase       String?
  sessions    Session[]

  @@index([userId, weekStart])
}

model Session {
  id          String       @id @default(cuid())
  planId      String
  plan        TrainingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  date        DateTime
  sport       String
  titre       String
  dureeMin    Int
  distanceKm  Float?
  description String       @default("")
  objectif    String?
  structure   Json?
  status      String       @default("planifiee")
  ressenti    String?
  completedAt DateTime?

  @@index([userId, date])
  @@index([planId])
}

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String
  content   String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Seul le hash du jeton est stocké : une fuite de la base ne permet pas de réinitialiser un compte.
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}
