generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  passwordHash      String
  name              String
  avatarUrl         String?
  /// Date du dernier changement de photo. Sa présence indique qu'une photo
  /// existe, et sa valeur sert à invalider le cache du navigateur.
  avatarUpdatedAt   DateTime?
  plan              String    @default("free")
  /// "athlete" ou "admin". Seul un admin accède à /api/admin.
  role              String    @default("athlete")
  /// Fuseau IANA de l'athlète : la semaine d'entraînement est calculée dessus.
  timezone          String    @default("Europe/Paris")
  /// Dernière requête authentifiée : base du calcul de fréquentation.
  lastSeenAt        DateTime?
  /// Tentatives de connexion infructueuses consécutives, et blocage temporaire.
  /// Contrairement à la limitation par adresse IP, ce compteur est partagé
  /// entre toutes les instances du serveur.
  failedLogins      Int       @default(0)
  lockedUntil       DateTime?
  /// Date de vérification de l'adresse e-mail (null tant qu'elle ne l'est pas).
  emailVerifiedAt   DateTime?
  /// Acceptation des conditions et de la politique de confidentialité, et
  /// version acceptée : une évolution des conditions doit être re-consentie.
  consentAcceptedAt DateTime?
  consentVersion    String?
  createdAt         DateTime  @default(now())

  profile                AthleteProfile?
  trainingPlans          TrainingPlan[]
  sessions               Session[]
  chatMessages           ChatMessage[]
  resetTokens            PasswordResetToken[]
  aiCalls                AiCall[]
  adminActions           AdminAction[]            @relation("AdminActor")
  receivedAdminActions   AdminAction[]            @relation("AdminTarget")
  GenerationJob          GenerationJob[]
  EmailVerificationToken EmailVerificationToken[]

  @@index([lastSeenAt])
  @@index([createdAt])
}

/// Jeton de vérification d'adresse e-mail. Comme pour la réinitialisation de
/// mot de passe, seul le hash est conservé.
model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// Une génération de programme en cours ou terminée. La génération dure
/// souvent plus d'une minute : elle est lancée en tâche de fond et l'athlète
/// suit son avancement, au lieu de tenir une requête HTTP ouverte que les
/// proxys finissent par couper.
model GenerationJob {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "premiere_semaine" | "semaine_suivante"
  kind      String
  /// "en_attente" | "en_cours" | "reussie" | "echouee"
  status    String    @default("en_attente")
  planId    String?
  error     String?
  startedAt DateTime?
  endedAt   DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

/// Un appel au modèle, avec sa consommation de tokens : permet de suivre le
/// coût réel du coach IA par athlète et par période.
model AiCall {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "plan_generation" | "plan_progression" | "chat"
  kind             String
  model            String
  inputTokens      Int      @default(0)
  outputTokens     Int      @default(0)
  cacheReadTokens  Int      @default(0)
  cacheWriteTokens Int      @default(0)
  /// Coût estimé en micro-dollars (entier : pas d'arrondi flottant cumulé).
  costMicroUsd     Int      @default(0)
  succeeded        Boolean  @default(true)
  createdAt        DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
}

/// Journal des actions d'administration : toute modification d'abonnement
/// faite à la main doit rester traçable.
model AdminAction {
  id           String   @id @default(cuid())
  adminId      String
  admin        User     @relation("AdminActor", fields: [adminId], references: [id], onDelete: Cascade)
  targetUserId String?
  targetUser   User?    @relation("AdminTarget", fields: [targetUserId], references: [id], onDelete: SetNull)
  action       String
  details      Json?
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

model AthleteProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  objectif      String
  objectifDate  DateTime
  tempsNatation String   @default("")
  tempsVelo     String   @default("")
  tempsCourse   String   @default("")
  heuresSemaine Float
  contraintes   String   @default("")
  /// Zones de puissance vélo si l'athlète connaît sa FTP (sinon estimation par la vitesse).
  ftpWatts      Int?
  /// Zones corrigées à la main par l'athlète : { course: { Z2: "5:30/km" }, ... }.
  /// Une valeur saisie ici prime sur le calcul automatique.
  customZones   Json?
  updatedAt     DateTime @updatedAt
}

model TrainingPlan {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekStart   DateTime
  generatedAt DateTime  @default(now())
  rawAiJson   String
  debrief     String?
  /// Phase de périodisation appliquée (base, developpement, specifique, affutage, course, transition).
  phase       String?
  sessions    Session[]

  @@index([userId, weekStart])
}

model Session {
  id          String       @id @default(cuid())
  planId      String
  plan        TrainingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  date        DateTime
  sport       String
  titre       String
  dureeMin    Int
  distanceKm  Float?
  description String       @default("")
  objectif    String?
  structure   Json?
  status      String       @default("planifiee")
  ressenti    String?
  completedAt DateTime?

  @@index([userId, date])
  @@index([planId])
}

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String
  content   String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Seul le hash du jeton est stocké : une fuite de la base ne permet pas de réinitialiser un compte.
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}
