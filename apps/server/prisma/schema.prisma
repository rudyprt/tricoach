generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  passwordHash      String
  name              String
  avatarUrl         String?
  /// Date du dernier changement de photo. Sa présence indique qu'une photo
  /// existe, et sa valeur sert à invalider le cache du navigateur.
  avatarUpdatedAt   DateTime?
  plan              String    @default("free")
  /// "athlete" ou "admin". Seul un admin accède à /api/admin.
  role              String    @default("athlete")
  /// Fuseau IANA de l'athlète : la semaine d'entraînement est calculée dessus.
  timezone          String    @default("Europe/Paris")
  /// Dernière requête authentifiée : base du calcul de fréquentation.
  lastSeenAt        DateTime?
  /// Tentatives de connexion infructueuses consécutives, et blocage temporaire.
  /// Contrairement à la limitation par adresse IP, ce compteur est partagé
  /// entre toutes les instances du serveur.
  failedLogins      Int       @default(0)
  lockedUntil       DateTime?
  /// Date de vérification de l'adresse e-mail (null tant qu'elle ne l'est pas).
  emailVerifiedAt   DateTime?
  /// Acceptation des conditions et de la politique de confidentialité, et
  /// version acceptée : une évolution des conditions doit être re-consentie.
  consentAcceptedAt DateTime?
  consentVersion    String?
  /// Rappels par e-mail (semaine à générer, séances oubliées, fin d'essai).
  /// Désactivable en un clic depuis chaque message, sans se connecter.
  rappelsEmail      Boolean   @default(true)
  createdAt         DateTime  @default(now())

  profile                AthleteProfile?
  trainingPlans          TrainingPlan[]
  sessions               Session[]
  chatMessages           ChatMessage[]
  resetTokens            PasswordResetToken[]
  aiCalls                AiCall[]
  adminActions           AdminAction[]            @relation("AdminActor")
  receivedAdminActions   AdminAction[]            @relation("AdminTarget")
  GenerationJob          GenerationJob[]
  EmailVerificationToken EmailVerificationToken[]
  StravaAccount          StravaAccount?
  Activity               Activity[]
  fitnessTests           FitnessTest[]
  reminders              Reminder[]

  @@index([lastSeenAt])
  @@index([createdAt])
}

/// Jeton de vérification d'adresse e-mail. Comme pour la réinitialisation de
/// mot de passe, seul le hash est conservé.
model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// Connexion au compte Strava d'un athlète. Les jetons sont conservés pour
/// rafraîchir l'accès sans redemander l'autorisation à chaque import.
model StravaAccount {
  id           String    @id @default(cuid())
  userId       String    @unique
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Identifiant de l'athlète chez Strava.
  athleteId    String    @unique
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  /// Nom affiché chez Strava, pour que l'athlète sache quel compte est relié.
  athleteName  String?
  lastSyncAt   DateTime?
  createdAt    DateTime  @default(now())
}

/// Activité réellement effectuée, importée depuis Strava. Distincte de Session,
/// qui est ce qui était planifié : c'est l'écart entre les deux qui a de la
/// valeur pour le coach.
model Activity {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Identifiant chez la source, pour ne jamais importer deux fois la même.
  externalId     String
  source         String   @default("strava")
  /// "natation" | "velo" | "course" | "renfo" | "autre"
  sport          String
  name           String
  startedAt      DateTime
  dureeMin       Int
  distanceKm     Float?
  /// Dénivelé positif en mètres.
  denivelePosM   Int?
  /// Fréquence cardiaque moyenne, si la montre l'a mesurée.
  fcMoyenne      Int?
  fcMax          Int?
  /// Puissance moyenne en watts (vélo).
  puissanceMoy   Int?
  /// Allure moyenne en secondes par kilomètre, calculée à l'import.
  allureSecParKm Int?
  /// Séance planifiée à laquelle l'activité a été rapprochée, le cas échéant.
  sessionId      String?
  importedAt     DateTime @default(now())

  @@unique([source, externalId])
  @@index([userId, startedAt])
}

/// Une génération de programme en cours ou terminée. La génération dure
/// souvent plus d'une minute : elle est lancée en tâche de fond et l'athlète
/// suit son avancement, au lieu de tenir une requête HTTP ouverte que les
/// proxys finissent par couper.
model GenerationJob {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "premiere_semaine" | "semaine_suivante"
  kind      String
  /// "en_attente" | "en_cours" | "reussie" | "echouee"
  status    String    @default("en_attente")
  planId    String?
  error     String?
  startedAt DateTime?
  endedAt   DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

/// Un appel au modèle, avec sa consommation de tokens : permet de suivre le
/// coût réel du coach IA par athlète et par période.
model AiCall {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "plan_generation" | "plan_progression" | "chat"
  kind             String
  model            String
  inputTokens      Int      @default(0)
  outputTokens     Int      @default(0)
  cacheReadTokens  Int      @default(0)
  cacheWriteTokens Int      @default(0)
  /// Coût estimé en micro-dollars (entier : pas d'arrondi flottant cumulé).
  costMicroUsd     Int      @default(0)
  succeeded        Boolean  @default(true)
  createdAt        DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
}

/// Journal des actions d'administration : toute modification d'abonnement
/// faite à la main doit rester traçable.
model AdminAction {
  id           String   @id @default(cuid())
  adminId      String
  admin        User     @relation("AdminActor", fields: [adminId], references: [id], onDelete: Cascade)
  targetUserId String?
  targetUser   User?    @relation("AdminTarget", fields: [targetUserId], references: [id], onDelete: SetNull)
  action       String
  details      Json?
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

model AthleteProfile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  objectif            String
  objectifDate        DateTime
  tempsNatation       String   @default("")
  tempsVelo           String   @default("")
  tempsCourse         String   @default("")
  heuresSemaine       Float
  contraintes         String   @default("")
  /// Zones de puissance vélo si l'athlète connaît sa FTP (sinon estimation par la vitesse).
  ftpWatts            Int?
  /// Allure au seuil en course, en secondes par kilomètre, si l'athlète la connaît.
  seuilCourseSecParKm Int?
  /// Vitesse critique en natation (CSS), en secondes aux 100 m.
  cssSecPer100m       Int?
  /// Fréquence cardiaque au seuil, mesurée lors d'un test.
  fcSeuil             Int?
  /// Fréquence cardiaque maximale connue.
  fcMax               Int?
  /// Zones corrigées à la main par l'athlète : { course: { Z2: "5:30/km" }, ... }.
  /// Une valeur saisie ici prime sur le calcul automatique.
  customZones         Json?
  updatedAt           DateTime @updatedAt
}

model TrainingPlan {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekStart   DateTime
  generatedAt DateTime  @default(now())
  rawAiJson   String
  debrief     String?
  /// Phase de périodisation appliquée (base, developpement, specifique, affutage, course, transition).
  phase       String?
  sessions    Session[]

  @@index([userId, weekStart])
}

model Session {
  id          String       @id @default(cuid())
  planId      String
  plan        TrainingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  date        DateTime
  sport       String
  titre       String
  dureeMin    Int
  distanceKm  Float?
  description String       @default("")
  objectif    String?
  structure   Json?
  status      String       @default("planifiee")
  ressenti    String?
  completedAt DateTime?

  @@index([userId, date])
  @@index([planId])
}

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String
  content   String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Seul le hash du jeton est stocké : une fuite de la base ne permet pas de réinitialiser un compte.
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// Un test de terrain programmé par le coach IA, puis son résultat. C'est la
/// mesure qui remplace l'estimation : tant qu'aucun test n'a été réalisé, les
/// zones reposent sur un temps de référence déclaré, parfois ancien.
model FitnessTest {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "course" | "velo" | "natation"
  sport        String
  /// Protocole appliqué : "course_30min", "velo_20min", "natation_css".
  kind         String
  /// Jour où le test est programmé, et semaine à laquelle il appartient.
  scheduledFor DateTime
  weekStart    DateTime
  /// "planifie" | "realise" | "abandonne"
  status       String    @default("planifie")
  /// Résultats bruts saisis par l'athlète (ou repris d'une activité importée).
  distanceM    Int?
  puissanceMoy Int?
  temps400S    Int?
  temps200S    Int?
  fcMoyenne    Int?
  /// Valeurs de seuil déduites du résultat, et date de leur application au profil.
  resume       String?
  appliedAt    DateTime?
  createdAt    DateTime  @default(now())

  @@index([userId, scheduledFor])
  @@index([userId, sport, status])
}

/// Trace des rappels envoyés. La contrainte d'unicité est le garde-fou : sans
/// elle, un redémarrage du serveur, ou deux instances tournant en parallèle,
/// enverraient deux fois le même message au même athlète.
model Reminder {
  id      String   @id @default(cuid())
  userId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "semaine_a_generer" | "seances_oubliees" | "fin_essai"
  kind    String
  /// Clé de période qui rend l'envoi idempotent ("2026-W38", "2026-09-15"...).
  periode String
  sentAt  DateTime @default(now())

  @@unique([userId, kind, periode])
  @@index([userId, sentAt])
}
