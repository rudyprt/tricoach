# Base Postgres (ex. Neon, Supabase, Render Postgres)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Secret de signature des sessions : 32 caractères minimum.
# Générer avec : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Coach IA (génération de programme + chat). Sans clé, le reste de l'app fonctionne.
ANTHROPIC_API_KEY=""

PORT=3001
CLIENT_ORIGIN="http://localhost:5173"

# URL publique de l'application, utilisée dans les e-mails de réinitialisation.
APP_URL="http://localhost:5173"

# Comptes administrateurs de départ (emails séparés par des virgules).
# Seuls des comptes DÉJÀ INSCRITS sont promus : inscrivez-vous d'abord dans
# l'application, puis renseignez votre email ici. Permet de désigner le premier
# administrateur sans ligne de commande, depuis le tableau de bord de
# l'hébergeur. Peut être vidé une fois la promotion effectuée.
ADMIN_EMAILS=""

# Envoi d'e-mails : réinitialisation de mot de passe et vérification d'adresse.
# Sans SMTP_HOST, les messages sont tracés dans les logs au lieu d'être envoyés
# et la récupération de compte ne fonctionne pas réellement.
# Exemple avec Brevo : smtp-relay.brevo.com / 587 / votre identifiant / votre clé.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_SECURE="false"
MAIL_FROM="TriCoach <ne-pas-repondre@votre-domaine.fr>"

# "disabled" : l'activation d'une offre payante depuis l'app est refusée
# (aucun prestataire de paiement n'est branché). "open" : activation directe,
# pour le développement et les démos uniquement.
BILLING_MODE="disabled"
