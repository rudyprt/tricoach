# La même base que l'application (apps/server/.env).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Secret de session propre à l'outil, 32 caractères minimum, différent de JWT_SECRET.
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
GESTION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

PORT=3002
